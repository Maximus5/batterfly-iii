<?xml version="1.0" encoding="utf-8"?>
<!-- AlertDialog.Builder's setMessage + setAdapter don't actually combine - the adapter's list
     silently doesn't render when a message is also set. This plain custom view (a summary
     TextView followed by per-match rows, both added programmatically) replaces that broken
     combination for the rule editor's "Test results" dialog. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/testResultsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp" />

</ScrollView>
