<?xml version="1.0" encoding="utf-8"?>
<!-- Three actions (no "Create anyway" - showCreateAnyway=false, see MessagesFragment.
     showDuplicateConfirmDialog) in one row instead of stacked - tighter than a vertical list of
     three full-width rows, which left excess vertical gap between each. Order left-to-right:
     Use Created, Open (one group - acting on the found transaction), then Cancel always last. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <Button
        android:id="@+id/useCreatedButton"
        style="?attr/borderlessButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="40dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:text="@string/create_duplicate_use_created" />

    <Button
        android:id="@+id/openDuplicateButton"
        style="?attr/borderlessButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="40dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:text="@string/create_open_transaction" />

    <Button
        android:id="@+id/cancelDuplicateButton"
        style="?attr/borderlessButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="40dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:text="@android:string/cancel" />

</LinearLayout>
