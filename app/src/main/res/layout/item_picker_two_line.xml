<?xml version="1.0" encoding="utf-8"?>
<!-- The outer padding (not margin) is what actually creates space between rows - ListView
     ignores layout_margin on a row's root view, so the gap has to come from padding here, with
     the bordered background on the inner container instead of the root. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_picker_item"
        android:padding="12dp">

        <TextView
            android:id="@+id/pickerItemHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/pickerItemBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
