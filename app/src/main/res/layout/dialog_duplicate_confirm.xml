<?xml version="1.0" encoding="utf-8"?>
<!-- Four actions, not three - AlertDialog.Builder's positive/negative/neutral slots max out at
     three buttons, so this is a plain custom view (same reasoning as dialog_test_results.xml)
     instead, one full-width borderless button per row. Order matters here: Cancel is always last
     (user-specified), Open sits right after Use Created so acting on the found transaction (link
     or inspect it) reads as one group before the "post a new one anyway" / "never mind" pair. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <Button
        android:id="@+id/useCreatedButton"
        style="?attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textAllCaps="false"
        android:text="@string/create_duplicate_use_created" />

    <Button
        android:id="@+id/openDuplicateButton"
        style="?attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textAllCaps="false"
        android:text="@string/create_duplicate_open" />

    <Button
        android:id="@+id/createAnywayButton"
        style="?attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textAllCaps="false"
        android:text="@string/create_duplicate_confirm_button" />

    <Button
        android:id="@+id/cancelDuplicateButton"
        style="?attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textAllCaps="false"
        android:text="@android:string/cancel" />

</LinearLayout>
