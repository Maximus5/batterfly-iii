<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext stays permitted at the platform level because the Firefly III host is whatever the
     user types in Settings, so it can't be scoped to a domain at build time, and a network
     security config can't be toggled at runtime. The actual gate is in the app:
     FireflyApiClient refuses plain http:// (before sending the token) unless the user has turned
     on "Allow unencrypted HTTP" on the Firefly connection screen. Every other request this app
     makes (exchange rates) is https://. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
